#######################################################################
# PRODUCTION DJANGO .GITIGNORE (2025 STANDARD)
#######################################################################

# -------------------------------
# Python bytecode
# -------------------------------
__pycache__/
*.py[cod]
*$py.class

# -------------------------------
# Virtual Environments
# -------------------------------
venv/
.env/
.venv/
env/
ENV/

# -------------------------------
# Django / Python Runtime
# -------------------------------
*.log
*.pot
*.pyc

# Local DBs (never commit)
db.sqlite3
*.sqlite3

# Media files (user uploads)
media/

# Static (generated by collectstatic)
# staticfiles/
# static/

# -------------------------------
# Environment Configuration
# -------------------------------
# Environment variable files
*.env
.env.*
*.local
*.ini

# Secrets
secrets.json

# -------------------------------
# Build / Deployment Artifacts
# -------------------------------
# Gunicorn / Uvicorn / Daphne PID
*.pid

# Compiled C extensions
*.so

# Packaging
build/
dist/
*.egg-info/

# -------------------------------
# Testing / Coverage
# -------------------------------
htmlcov/
.coverage
.pytest_cache/

# -------------------------------
# Mypy, Pyre, Ruff, Black, isort
# -------------------------------
.mypy_cache/
.pyre/
.ruff_cache/
.black_cache/
.isort.cfg

# -------------------------------
# IDE / Editor Files
# -------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS junk
.DS_Store
Thumbs.db

# -------------------------------
# Docker
# -------------------------------
docker-compose.override.yml
*.log
*.tmp

# -------------------------------
# Node.js (if using React/Vite frontend inside project)
# -------------------------------
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -------------------------------
# Celery / Redis / Task queues
# -------------------------------
celerybeat-schedule
celerybeat.pid
dump.rdb
